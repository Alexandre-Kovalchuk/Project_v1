{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "deny": ["Read(**/.env)", "Read(**/.env.*)", "Read(~/.ssh/**)"]
  },
  "sandbox": {
    "enabled": true,
    "filesystem": {
      "denyRead": [
        "~/.env",
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.kube/config"
      ]
    }
  }
}
